{
    "name": "One Piece",
    "menuBackgroundImage": "https://valcur.github.io/TCG-Arena-OnePiece/Images/banner.jpg",
    "deckBuilding": {
        "mainFilters": [
            "type",
            "colors",
            "rarity"
        ],
        "formats": [
            {
                "title": "Classic",
                "gameplay": "Classic",
                "deckRuleset": "Classic"
            }
        ],
        "deckRulesets": {
            "Classic": {
                "general": {
                    "min": 50,
                    "max": 50,
                    "maxPerCard": 4
                },
                "categories": [
                    {
                        "category": "Leader",
                        "min": 1,
                        "max": 1,
                        "ignoreTotalCount": true
                    },
                    {
                        "category": "DON!!",
                        "min": 1,
                        "max": 10,
                        "maxPerCard": 10,
                        "ignoreTotalCount": true
                    }
                ]
            }
        }
    },
    "gameplay": {
        "Classic": {
            "beforeGameStart": {
                "initialBoardSetup": {
                    "0": [
                        {
                            "drawFromTop": "Don",
                            "count": 1,
                            "destination": "Mana"
                        }
                    ]
                },
                "chooseAnotherStartingPlayer": true
            },
            "mulligan": {
                "info": "You can draw a new hand once.",
                "startingHandSize": 5,
                "triggeredByButton": true,
                "mulliganCount": {
                    "max": 1
                },
                "mulliganCycle": {
                    "selectionRange": {
                        "min": 5
                    },
                    "steps": [
                        "toBottom",
                        "shuffle",
                        "draw"
                    ]
                }
            },
            "newTurn": {
                "drawOnStart": false,
                "drawPerTurn": 1
            },
            "tokens": [],
            "draggableTokens": [],
            "countersStartingValues": [],
            "sections": {
                "layout": {
                    "direction": "column",
                    "content": [
                        {
                            "direction": "row",
                            "isSymetricalForOpponents": true,
                            "content": [
                                {
                                    "section": "Life"
                                },
                                {
                                    "direction": "row",
                                    "style": {
                                        "width": "18vh",
                                        "marginRight": "3vh"
                                    },
                                    "content": [
                                        {
                                            "section": "Damage"
                                        },
                                        {
                                            "section": "Manager"
                                        }
                                    ]
                                },
                                {
                                    "section": "Character"
                                }
                            ]
                        },
                        {
                            "direction": "row",
                            "isSymetricalForOpponents": true,
                            "content": [
                                {
                                    "section": "Don"
                                },
                                {
                                    "section": "Mana"
                                },
                                {
                                    "section": "Leader",
                                    "style": {
                                        "width": "11.5vh",
                                        "marginLeft": "10vh"
                                    }
                                },
                                {
                                    "section": "Stage",
                                    "style": {
                                        "width": "11.5vh"
                                    }
                                }
                            ]
                        }
                    ]
                },
                "categoriesAlreadyOnBoard": [
                    "DON!!->Don",
                    "Leader"
                ],
                "autoPlayFromHand": {
                    "DON!!": "Mana",
                    "Event": "Stack",
                    "Character": "Character",
                    "Stage": "Stage",
                    "Leader": "Leader"
                },
                "autoPlayFromStack": {
                    "DON!!": "Mana",
                    "Event": "Discard",
                    "Character": "Character",
                    "Stage": "Stage",
                    "Leader": "Leader"
                },
                "sectionsDict": {
                    "Character": {
                        "isHidden": "no",
                        "height": 19,
                        "alignment": "CENTER",
                        "isHorizontalAllowed": true,
                        "isGroupForbidden": true,
                        "displayedTitle": "Character Area",
                        "noQuickActions": true,
                        "enterTapped": true
                    },
                    "Life": {
                        "isHidden": "yes",
                        "height": 19,
                        "alignment": "DECK",
                        "isGroupForbidden": true,
                        "displayedTitle": "Life",
                        "drawDestinations": {
                            "_default": "Damage"
                        }
                    },
                    "Damage": {
                        "isHidden": "opponent-only",
                        "height": 19,
                        "alignment": "CENTER",
                        "isGroupForbidden": true,
                        "displayedTitle": "Damage",
                        "noQuickActions": true,
                        "events": {
                            "onCardsEnter": "await updateDamageCount()",
                            "onCardsLeave": "await updateDamageCount()"
                        }
                    },
                    "Leader": {
                        "isHidden": "no",
                        "height": 16,
                        "alignment": "NONE",
                        "isHorizontalAllowed": true,
                        "displayedTitle": "Leader Card",
                        "noQuickActions": true,
                        "enterTapped": true
                    },
                    "Don": {
                        "isHidden": "yes",
                        "height": 16,
                        "alignment": "DECK",
                        "displayedTitle": "DON Deck",
                        "drawPerTurn": 2
                    },
                    "Mana": {
                        "isHidden": "no",
                        "height": 16,
                        "alignment": "START",
                        "isHorizontalAllowed": true,
                        "isGroupForbidden": true,
                        "displayedTitle": "Cost Area"
                    },
                    "Stage": {
                        "isHidden": "no",
                        "height": 16,
                        "alignment": "CENTER",
                        "isHorizontalAllowed": false,
                        "isGroupForbidden": false,
                        "displayedTitle": "Stage Card"
                    },
                    "Manager": {
                        "type": "custom",
                        "defaultValue": {
                            "damageCount": 0
                        },
                        "blueprint": {
                            "type": "div",
                            "props": {
                                "className": "player-only position-absolute top-0 start-50 gap-2",
                                "style": {
                                    "display": "{{ game.data.Manager.damageCount > 0 ? 'flex' : 'none' }}",
                                    "translate": "-50% -100%"
                                }
                            },
                            "children": [
                                {
                                    "type": "button",
                                    "onClick": "await revealDamage()",
                                    "children": "Reveal"
                                },
                                {
                                    "type": "button",
                                    "onClick": "await drawDamage()",
                                    "children": "Draw"
                                }
                            ]
                        },
                        "events": {
                            "onPlayersReady": "await onPlayersReady()"
                        }
                    }
                }
            }
        }
    },
    "defaultRessources": {
        "backgrounds": [
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat1.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat2.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat3.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat4.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat5.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat6.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat7.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat8.webp",
            "https://valcur.github.io/TCG-Arena-OnePiece/Images/Playmats/playmat9.webp"
        ],
        "decksUrl": ""
    },
    "customHelp": "",
    "cards": {
        "dataUrl": "https://valcur.github.io/TCG-Arena-OnePiece/OnePieceCards.json",
        "cardBack": "https://valcur.github.io/TCG-Arena-OnePiece/Images/cardBack.jpg"
    },
    "scriptsUrls": [
        "https://valcur.github.io/TCG-Arena-OnePiece/functions.jsx"
    ]
}
